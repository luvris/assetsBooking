PORT=3000

# MariaDB
# ถ้าใช้ MariaDB ในเครื่อง/เซิร์ฟเวอร์ปกติ: DB_HOST=127.0.0.1
# ถ้าใช้ MariaDB ใน Docker Desktop (service ใน compose): DB_HOST=host.docker.internal
# ถ้าใช้ service db (profile local-db) ของ compose.yaml: DB_HOST=db, DB_PORT=3306
DB_HOST=127.0.0.1
DB_PORT=3309
DB_NAME=assets_booking
DB_USER=assets_api
DB_PASSWORD=change-me

# origin ของ frontend ที่อนุญาตให้เรียก API
CORS_ORIGIN=http://localhost:5173

# หมายเหตุ: ผู้ใช้ DB_USER ต้องถูกสร้างเป็น '<user>'@'%'
# ถ้าสร้างเป็น '<user>'@'localhost' เท่านั้น backend ที่รันใน Docker จะเชื่อมต่อไม่ได้
# (Access denied) ดูรายละเอียดที่ database/README.md
