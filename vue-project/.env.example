APP_PORT=5173

# frontend เรียก API ผ่าน path /api (Vite proxy ใน dev, nginx proxy ใน Docker)
VITE_API_BASE_URL=/api

# Keycloak (ต้องเป็น client ที่อนุญาต redirect URI http://localhost:5173/*)
VITE_KEYCLOAK_URL=https://auth.example.go.th
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_CLIENT_ID=your-client-id

# (ทางเลือก) ใช้เมื่อรัน MariaDB ใน Docker ด้วย: docker compose --profile local-db up -d
# (ค่าด้านล่างนี้ compose จะอ่านจากไฟล์ .env นี้โดยตรง ถ้าไม่ใช้ก็คอมเมนต์ไว้ได้)
# MARIADB_ROOT_PASSWORD=changeme-root
# MARIADB_PASSWORD=changeme-app
# DB_PORT=3309
